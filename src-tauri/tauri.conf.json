{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StructureCraft",
  "version": "0.1.0",
  "identifier": "com.theravanz.dev",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "StructureCraftLauncher",
        "width": 1024,
        "height": 576,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUzRjVFMzY3REY3Q0I2OUEKUldTYXRuemZaK1AxVTVHcXFwd0J4Z1BtU2QxMk9OUmZRRkJLd3F0RFdBUkExY2NKSmd6UXNPRXoK",
      "endpoints": [
        "https://github.com/theravanz/sc-launcher/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
